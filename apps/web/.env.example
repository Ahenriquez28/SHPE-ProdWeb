# Copy this to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Clerk publishable key (safe to expose to browser — it's a public key)
# Get it from: https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_PUBLISHABLE_KEY

# API base URL — leave empty in dev (Vite proxies /api → localhost:5001)
# In staging/prod set to: https://staging.shpegsu.com
VITE_API_URL=

# ─── Database ───────────────────────────────────────────
# Postgres connection string (auto-set by Docker Compose in dev)
DATABASE_URL=Host=localhost;Port=5432;Database=shpe_dev;Username=postgres;Password=postgres

# ─── Clerk Auth ─────────────────────────────────────────
# Get these from dashboard.clerk.com → API Keys
# REPLACE with your actual keys
CLERK_ISSUER=https://your-clerk-issuer.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_REPLACE

# ─── Bootstrap ──────────────────────────────────────────
# The first person who signs up with this email gets super_admin automatically
# REPLACE with your email
BOOTSTRAP_SUPER_ADMIN_EMAIL=REPLACE@gmail.com

# ─── DigitalOcean Spaces (file uploads) ─────────────────
# Get these from DigitalOcean → Spaces → Manage Keys
# REPLACE with your actual keys
DO_SPACES_KEY=REPLACE
DO_SPACES_SECRET=REPLACE
DO_SPACES_BUCKET=shpegsu-staging
DO_SPACES_REGION=nyc3

# ─── AWS SES (email sending) ─────────────────────────────
# Get these from AWS Console → IAM → your user → Access Keys
# REPLACE with your actual keys
AWS_ACCESS_KEY_ID=REPLACE
AWS_SECRET_ACCESS_KEY=REPLACE
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=noreply@shpegsu.com

# ─── Telnyx (SMS sending) ────────────────────────────────
# Get this from portal.telnyx.com → API Keys
# REPLACE with your actual key
TELNYX_API_KEY=REPLACE
TELNYX_PHONE_NUMBER=+14706728573
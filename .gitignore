# ── .NET build artifacts ─────────────────────────────────
bin/
obj/
*.user
*.suo
.vs/

# ── Environment / secrets ────────────────────────────────
# .env.example IS committed (it has only placeholders, no real secrets)
.env
.env.local
.env.*.local
# appsettings.Development.json holds real local credentials — never commit
apps/api/appsettings.Development.json

# ── Node / frontend ──────────────────────────────────────
node_modules/
apps/web/dist/
apps/web/.vite/

# ── macOS ─────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE ──────────────────────────────────────────────────
.idea/
*.swp
*.swo

# ── Claude Code local settings (developer-specific permissions) ──────────────
.claude/settings.local.json

# ── Docker volumes (never accidentally committed) ─────────
postgres_data/
